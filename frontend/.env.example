# Copy to frontend/.env. Everything here ends up in the browser bundle: never put a secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=   # publishable (anon) key
VITE_API_URL=http://localhost:8000
# Optional: lets the demo-account buttons on the login page sign in with one click.
VITE_DEMO_PASSWORD=
