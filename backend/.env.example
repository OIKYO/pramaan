# Copy to backend/.env and fill in. Never commit .env.

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=          # secret (service role) key: server only, never in the frontend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash # a free-tier Flash model from Google AI Studio
READER_MODE=fixture           # fixture (no Gemini calls) | live
ALLOWED_ORIGINS=http://localhost:5173
TESSERACT_CMD=                # Windows only, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
DEMO_PASSWORD=                # password for the demo accounts created by scripts/seed.py

# Optional backup reader, used only when Gemini fails (OpenAI-compatible vision model on Groq).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
